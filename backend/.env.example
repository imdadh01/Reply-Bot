# Keep this file's real values on your server. Never commit .env.
GEMINI_API_KEY=replace_with_your_gemini_key
# Select an available free-tier text model from your AI Studio account.
GEMINI_MODEL=gemini-2.5-flash-lite
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_TOKEN=replace_with_a_random_64_character_token
PORT=8787
HOST=127.0.0.1
DAILY_LIMIT=30
DATA_DIR=./data
# Exact browser origins, comma-separated, no wildcard. Android sends no Origin.
# Example: chrome-extension://YOUR_EXTENSION_ID
ALLOWED_ORIGINS=
